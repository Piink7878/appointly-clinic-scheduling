-- F-007: the settings change was audited with the administrator user and a UTC timestamp (AC-F007-01)
appointly_test=> select a.action_type, a.entity_type, u.email as performed_by, a.created_at from audit_logs a join users u on u.user_id = a.user_id where a.action_type = 'CLINIC_SETTINGS_UPDATED' order by a.created_at desc limit 3;
