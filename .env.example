# ==============================================================================
# Appointly Monorepo — Environment Variables Template
# ==============================================================================
# Reference: System-Level Software Design Specification (SDS) Section 8.2
# DO NOT commit your real .env file. Real secrets must NEVER be stored in Git.
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Runtime & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=appointly
POSTGRES_PASSWORD=appointly_dev_secret
POSTGRES_DB=appointly
DATABASE_URL=postgresql://appointly:appointly_dev_secret@localhost:5432/appointly?schema=public

# ------------------------------------------------------------------------------
# Security & JWT Authentication Keys (Secrets)
# ------------------------------------------------------------------------------
# On GCP (Lab 5), these are stored in GCP Secret Manager and mounted at runtime.
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32bytes_minimum
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32bytes_minimum

# ------------------------------------------------------------------------------
# Clinic System Defaults
# ------------------------------------------------------------------------------
CLINIC_DEFAULT_TIMEZONE=Asia/Bangkok
CLINIC_TIMEZONE=Asia/Bangkok

# ------------------------------------------------------------------------------
# Seed & Demo Data Initialization (Local & Staging Only)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@appointly.local
SEED_DEFAULT_PASSWORD=ChangeMe123!

# ------------------------------------------------------------------------------
# Frontend Client Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_URL=http://localhost:4000

