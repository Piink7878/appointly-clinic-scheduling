-- F-002: the patient profile edited through the UI is stored in PostgreSQL
appointly_test=> select p.full_name, p.phone_number, p.date_of_birth, u.email from patients p join users u on u.user_id = p.user_id where u.email = 'patient.arisa@appointly.local';
    full_name    | phone_number | date_of_birth |             email             
-----------------+--------------+---------------+-------------------------------
 Arisa Wongsuwan | 0898765432   | 1991-02-03    | patient.arisa@appointly.local
(1 row)

-- F-004 / F-005: the service created in the UI and its doctor assignments
appointly_test=> select s.service_name, s.duration_minutes, s.service_status, d.full_name as assigned_doctor, u.email from medical_services s join doctor_services ds on ds.service_id = s.service_id join doctors d on d.doctor_id = ds.doctor_id join users u on u.user_id = d.user_id where s.service_name = 'Dental Cleaning' order by d.full_name;
  service_name   | duration_minutes | service_status |   assigned_doctor   |         email          
-----------------+------------------+----------------+---------------------+------------------------
 Dental Cleaning |               30 | ACTIVE         | Dr. Somchai Prasert | doctor@appointly.local
(1 row)

-- F-006: split shifts saved on Saturday (day_of_week = 6) by the doctor
appointly_test=> select u.email, ds.day_of_week, ds.start_time, ds.end_time, ds.is_active from doctor_schedules ds join doctors d on d.doctor_id = ds.doctor_id join users u on u.user_id = d.user_id where u.email = 'doctor@appointly.local' and ds.day_of_week = 6 order by ds.start_time;
         email          | day_of_week | start_time | end_time | is_active 
------------------------+-------------+------------+----------+-----------
 doctor@appointly.local |           6 | 09:00      | 12:00    | t
 doctor@appointly.local |           6 | 13:00      | 17:00    | t
(2 rows)

-- F-006: the full-day HOLIDAY exception (start_time and end_time are NULL)
appointly_test=> select u.email, e.exception_date, e.exception_type, e.start_time, e.end_time, e.reason from schedule_exceptions e join doctors d on d.doctor_id = e.doctor_id join users u on u.user_id = d.user_id;
         email          | exception_date | exception_type | start_time | end_time |      reason      
------------------------+----------------+----------------+------------+----------+------------------
 doctor@appointly.local | 2026-12-31     | HOLIDAY        |            |          | New Year holiday
(1 row)

-- F-006: database CHECK constraints guarding schedule windows
appointly_test=> select conname, pg_get_constraintdef(oid) as definition from pg_constraint where conrelid = 'doctor_schedules'::regclass and contype = 'c' order by conname;
             conname              |                     definition                      
----------------------------------+-----------------------------------------------------
 chk_doctor_schedules_day_of_week | CHECK (((day_of_week >= 0) AND (day_of_week <= 6)))
 chk_doctor_schedules_time_window | CHECK (((end_time)::text > (start_time)::text))
(2 rows)

