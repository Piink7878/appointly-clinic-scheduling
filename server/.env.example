# ==============================================================================
# Appointly Server (Backend) — Environment Variables Template
# ==============================================================================
# Reference: System-Level Software Design Specification (SDS) Section 8.2
# DO NOT commit real .env files. Real secrets must NEVER be stored in Git.
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Runtime Environment (development, test, production)
NODE_ENV=development

# Server Port (default: 4000; Cloud Run injects 8080 or 3000)
PORT=4000

# PostgreSQL 16 Connection String (Local .env / GCP Secret Manager)
DATABASE_URL=postgresql://appointly:appointly_dev_secret@localhost:5432/appointly?schema=public

# Allowed Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173

# HttpOnly Cookie Secure Flag (false on HTTP localhost, true on HTTPS / Cloud Run)
COOKIE_SECURE=false

# Cryptographic Signing Keys for JWT Tokens (Secrets)
# Access Token TTL: 15 minutes, Refresh Token TTL: 7 days
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32bytes_minimum
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32bytes_minimum

# Clinic System Default Timezone (IANA Timezone String)
CLINIC_DEFAULT_TIMEZONE=Asia/Bangkok
CLINIC_TIMEZONE=Asia/Bangkok

# Synthetic Seed Administrator Email & Password for Local / Staging
SEED_ADMIN_EMAIL=admin@appointly.local
SEED_DEFAULT_PASSWORD=ChangeMe123!
